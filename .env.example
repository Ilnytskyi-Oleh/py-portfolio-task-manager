# Generate a strong key, e.g.: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,web-dev,web-prod
DJANGO_SETTINGS_MODULE=config.settings.dev

POSTGRES_DB=task_manager
POSTGRES_USER=task_manager
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Published only on 127.0.0.1. Change or remove mapping in compose for prod hosts.
POSTGRES_PUBLISH_PORT=5432

WEB_PORT=8000
SEED_DEMO=1

# Production defaults (used by config.settings.prod)
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
# Keep 0 behind local HTTP; set 1 when TLS terminates in front of the app
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=31536000
CSRF_TRUSTED_ORIGINS=https://example.com
